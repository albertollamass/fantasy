rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // App de uso personal, sin login (elegido por el usuario).
    // RECOMENDADO cuando puedas: activar Auth y cambiar a
    // allow read, write: if request.auth != null;
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
